# FalkorDB (Redis protocol). Local docker-compose uses no password.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
# Embedded engine (pip install falkordblite). When set, host/port Docker Redis is skipped.
# FALKORDB_LITE=/tmp/falkordb.db

# Default tenant graph is sentinel_<tenant>
TENANT_DEFAULT=demo

# none | bedrock | openai_compatible
# The LLM only writes a rationale paragraph. Decisions never read it.
LLM_PROVIDER=none
LLM_TIMEOUT_S=8

# Bedrock (optional)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# OpenAI-compatible (optional; works for xAI Grok)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=grok-4

# API
API_HOST=0.0.0.0
API_PORT=8000

# Optional. If set, POST /reset /run /close /approve require header X-Sentinel-Token.
SENTINEL_ADMIN_TOKEN=

# Optional. UI directory when the package is installed away from the repo checkout.
# SENTINEL_STATIC_DIR=

# Season clock used by precedent decay. Backtest sets this per season.
CURRENT_YEAR=2024
